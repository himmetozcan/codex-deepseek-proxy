<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.codex.deepseek-responses-proxy</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/YOU/.codex/codex-deepseek-proxy/proxy.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CODEX_DEEPSEEK_PROXY_PORT</key>
    <string>8877</string>
    <key>CODEX_DEEPSEEK_THINKING</key>
    <string>auto</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/YOU/.codex/deepseek-responses-proxy.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/.codex/deepseek-responses-proxy.stderr.log</string>
</dict>
</plist>
